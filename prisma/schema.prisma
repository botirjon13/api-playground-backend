generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MODERATOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum PracticalPlatformStatus {
  NOT_REQUESTED
  REQUESTED
  APPROVED
  REJECTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TicketCategory {
  INSTRUCTOR_APPLICATION
  TECHNICAL_ISSUE
  COURSE_QUESTION
  SUGGESTION
  FEEDBACK
  OTHER
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  NEEDS_INFORMATION
  CLOSED
  APPROVED
  REJECTED
}

enum AdStatus {
  ACTIVE
  PENDING_REVIEW
  REJECTED
  EXPIRED
}

enum CourseCompletionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum FinalTestAttemptStatus {
  FAILED
  PASSED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id    String @id @default(uuid())
  email String @unique

  fullName String? @map("full_name")

  passwordHash String @map("password_hash")
  role         Role   @default(STUDENT)

  xp Int @default(0)

  mission1 Boolean @default(false) @map("mission_1")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submissions               Submission[]
  coursesCreated            Course[]                 @relation("CourseCreator")
  coursesApproved           Course[]                 @relation("CourseApprover")
  courseEnrollments         CourseEnrollment[]
  coursesPublished          Course[]                 @relation("CoursePublisher")
  courseCertificates        CourseCertificate[]
  courseLessonCompletions   CourseLessonCompletion[]
  finalTestAttempts         CourseFinalTestAttempt[]
  courseCompletionReviews   CourseCompletionReview[] @relation("CompletionRequester")
  reviewedCourseCompletions CourseCompletionReview[] @relation("CompletionReviewer")
  reviewedFinalTestAttempts CourseFinalTestAttempt[] @relation("FinalTestReviewer")
  createdAds                AdCampaign[]             @relation("AdCreator")
  proposedAds               AdCampaign[]             @relation("AdProposer")
  approvedAds               AdCampaign[]             @relation("AdApprover")
  adEvents                  AdEvent[]
  supportTickets            SupportTicket[]          @relation("SupportTicketRequester")
  ticketMessages            SupportTicketMessage[]   @relation("SupportTicketMessageSender")

  @@map("users")
}

model Challenge {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String
  difficulty  Difficulty
  category    String
  is_active   Boolean    @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  submissions Submission[]

  @@map("Challenge")
}

model Submission {
  id String @id @default(uuid()) @db.Uuid

  userId      String @map("user_id")
  challengeId String @map("challenge_id") @db.Uuid

  githubUrl   String? @map("github_url")
  deployedUrl String? @map("deployed_url")

  createdAt DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@map("submissions")
}

model Course {
  id                      String                  @id @default(uuid()) @db.Uuid
  slug                    String                  @unique
  title                   String
  description             String
  level                   String
  isFree                  Boolean                 @default(true) @map("is_free")
  priceCents              Int?                    @map("price_cents")
  passingScore            Int                     @default(70) @map("passing_score")
  status                  CourseStatus            @default(DRAFT)
  practicalPlatformStatus PracticalPlatformStatus @default(NOT_REQUESTED) @map("practical_platform_status")
  instructorId            String?                 @map("instructor_id")
  approvedById            String?                 @map("approved_by_id")
  publishedById           String?                 @map("published_by_id")
  reviewFeedback          String?                 @map("review_feedback") @db.Text
  publishedAt             DateTime?               @map("published_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  instructor        User?                    @relation("CourseCreator", fields: [instructorId], references: [id], onDelete: SetNull)
  approvedBy        User?                    @relation("CourseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedBy       User?                    @relation("CoursePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  enrollments       CourseEnrollment[]
  lessons           CourseLesson[]
  finalQuestions    CourseFinalQuestion[]
  certificates      CourseCertificate[]
  completionReviews CourseCompletionReview[]
  finalTestAttempts CourseFinalTestAttempt[]

  @@index([status])
  @@map("courses")
}

model CourseLesson {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String   @db.VarChar(160)
  content   String   @db.Text
  videoUrl  String?  @map("video_url") @db.VarChar(2048)
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course      Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources   CourseResource[]
  completions CourseLessonCompletion[]

  @@unique([courseId, position])
  @@index([courseId, position])
  @@map("course_lessons")
}

model CourseResource {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  title    String @db.VarChar(160)
  url      String @db.VarChar(2048)
  position Int

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
  @@map("course_resources")
}

model CourseFinalQuestion {
  id            String @id @default(uuid()) @db.Uuid
  courseId      String @map("course_id") @db.Uuid
  prompt        String @db.Text
  optionA       String @map("option_a") @db.VarChar(1000)
  optionB       String @map("option_b") @db.VarChar(1000)
  optionC       String @map("option_c") @db.VarChar(1000)
  optionD       String @map("option_d") @db.VarChar(1000)
  correctOption Int    @map("correct_option")
  position      Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
  @@index([courseId, position])
  @@map("course_final_questions")
}

model CourseLessonCompletion {
  userId      String   @map("user_id")
  lessonId    String   @map("lesson_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("course_lesson_completions")
}

model CourseCertificate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id")
  courseId      String   @map("course_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(160)
  code          String   @unique @db.VarChar(32)
  issuedAt      DateTime @default(now()) @map("issued_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, issuedAt])
  @@map("course_certificates")
}

model CourseFinalTestAttempt {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @map("user_id")
  courseId       String                 @map("course_id") @db.Uuid
  answers        Json
  score          Int
  status         FinalTestAttemptStatus
  reviewFeedback String?                @map("review_feedback") @db.Text
  reviewedById   String?                @map("reviewed_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  reviewedAt     DateTime?              @map("reviewed_at")

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("FinalTestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([courseId, status, createdAt])
  @@index([userId, courseId, createdAt])
  @@map("course_final_test_attempts")
}

model CourseCompletionReview {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id")
  courseId     String                 @map("course_id") @db.Uuid
  status       CourseCompletionStatus @default(PENDING_REVIEW)
  feedback     String?                @db.Text
  reviewedById String?                @map("reviewed_by_id")
  createdAt    DateTime               @default(now()) @map("created_at")
  reviewedAt   DateTime?              @map("reviewed_at")

  user       User   @relation("CompletionRequester", fields: [userId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("CompletionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId, status, createdAt])
  @@map("course_completion_reviews")
}

model CourseEnrollment {
  userId     String           @map("user_id")
  courseId   String           @map("course_id") @db.Uuid
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([courseId])
  @@map("course_enrollments")
}

model AdCampaign {
  id             String   @id @default(uuid()) @db.Uuid
  title          String   @db.VarChar(160)
  imageUrl       String   @map("image_url") @db.VarChar(2048)
  targetUrl      String   @map("target_url") @db.VarChar(2048)
  status         AdStatus
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  durationDays   Int      @map("duration_days")
  proposedById   String?  @map("proposed_by_id")
  createdById    String   @map("created_by_id")
  approvedById   String?  @map("approved_by_id")
  reviewFeedback String?  @map("review_feedback") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  proposedBy User?     @relation("AdProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  createdBy  User      @relation("AdCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy User?     @relation("AdApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  events     AdEvent[]

  @@index([status, startsAt, endsAt])
  @@index([proposedById, createdAt])
  @@map("ad_campaigns")
}

model AdEvent {
  id        String   @id @default(uuid()) @db.Uuid
  adId      String   @map("ad_id") @db.Uuid
  userId    String?  @map("user_id")
  type      String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  ad   AdCampaign @relation(fields: [adId], references: [id], onDelete: Cascade)
  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([adId, type, createdAt])
  @@map("ad_events")
}

model SupportTicket {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @map("user_id")
  category             TicketCategory
  status               TicketStatus   @default(OPEN)
  subject              String         @db.VarChar(120)
  instructorSpecialty  String?        @map("instructor_specialty") @db.VarChar(160)
  instructorExperience String?        @map("instructor_experience") @db.Text
  instructorPortfolio  String?        @map("instructor_portfolio") @db.VarChar(2048)
  instructorCourseIdea String?        @map("instructor_course_idea") @db.Text
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  requester User                   @relation("SupportTicketRequester", fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportTicketMessage[]

  @@index([userId, updatedAt])
  @@index([category, status, updatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  senderId  String   @map("sender_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation("SupportTicketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}
