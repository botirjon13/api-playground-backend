generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MODERATOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum PracticalPlatformStatus {
  NOT_REQUESTED
  REQUESTED
  APPROVED
  REJECTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TicketCategory {
  INSTRUCTOR_APPLICATION
  TECHNICAL_ISSUE
  COURSE_QUESTION
  SUGGESTION
  FEEDBACK
  OTHER
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  NEEDS_INFORMATION
  CLOSED
  APPROVED
  REJECTED
}

model User {
  id    String @id @default(uuid())
  email String @unique

  fullName String? @map("full_name")

  passwordHash String @map("password_hash")
  role         Role   @default(STUDENT)

  xp Int @default(0)

  mission1 Boolean @default(false) @map("mission_1")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submissions       Submission[]
  coursesCreated    Course[]               @relation("CourseCreator")
  coursesApproved   Course[]               @relation("CourseApprover")
  courseEnrollments CourseEnrollment[]
  coursesPublished  Course[]               @relation("CoursePublisher")
  supportTickets    SupportTicket[]        @relation("SupportTicketRequester")
  ticketMessages    SupportTicketMessage[] @relation("SupportTicketMessageSender")

  @@map("users")
}

model Challenge {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String
  difficulty  Difficulty
  category    String
  is_active   Boolean    @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  submissions Submission[]

  @@map("Challenge")
}

model Submission {
  id String @id @default(uuid()) @db.Uuid

  userId      String @map("user_id")
  challengeId String @map("challenge_id") @db.Uuid

  githubUrl   String? @map("github_url")
  deployedUrl String? @map("deployed_url")

  createdAt DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@map("submissions")
}

model Course {
  id                      String                  @id @default(uuid()) @db.Uuid
  slug                    String                  @unique
  title                   String
  description             String
  level                   String
  isFree                  Boolean                 @default(true) @map("is_free")
  priceCents              Int?                    @map("price_cents")
  status                  CourseStatus            @default(DRAFT)
  practicalPlatformStatus PracticalPlatformStatus @default(NOT_REQUESTED) @map("practical_platform_status")
  instructorId            String?                 @map("instructor_id")
  approvedById            String?                 @map("approved_by_id")
  publishedById           String?                 @map("published_by_id")
  reviewFeedback          String?                 @map("review_feedback") @db.Text
  publishedAt             DateTime?               @map("published_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  instructor  User?              @relation("CourseCreator", fields: [instructorId], references: [id], onDelete: SetNull)
  approvedBy  User?              @relation("CourseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedBy User?              @relation("CoursePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  enrollments CourseEnrollment[]
  lessons     CourseLesson[]

  @@index([status])
  @@map("courses")
}

model CourseLesson {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String   @db.VarChar(160)
  content   String   @db.Text
  videoUrl  String?  @map("video_url") @db.VarChar(2048)
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources CourseResource[]

  @@unique([courseId, position])
  @@index([courseId, position])
  @@map("course_lessons")
}

model CourseResource {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  title    String @db.VarChar(160)
  url      String @db.VarChar(2048)
  position Int

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
  @@map("course_resources")
}

model CourseEnrollment {
  userId     String           @map("user_id")
  courseId   String           @map("course_id") @db.Uuid
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([courseId])
  @@map("course_enrollments")
}

model SupportTicket {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @map("user_id")
  category             TicketCategory
  status               TicketStatus   @default(OPEN)
  subject              String         @db.VarChar(120)
  instructorSpecialty  String?        @map("instructor_specialty") @db.VarChar(160)
  instructorExperience String?        @map("instructor_experience") @db.Text
  instructorPortfolio  String?        @map("instructor_portfolio") @db.VarChar(2048)
  instructorCourseIdea String?        @map("instructor_course_idea") @db.Text
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  requester User                   @relation("SupportTicketRequester", fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportTicketMessage[]

  @@index([userId, updatedAt])
  @@index([category, status, updatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  senderId  String   @map("sender_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation("SupportTicketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}
